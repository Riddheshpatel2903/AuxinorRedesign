# =============================================================================
# Render Environment Variables Template - Novasyn Chemicals
# =============================================================================
# Copy these variables and paste them into the "Environment Variables" section
# of your Render Web Service.

APP_NAME="Novasyn Chemicals"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-app-name.onrender.com

# Key must be 32 characters or base64:key (if empty, entrypoint.sh generates one)
# APP_KEY=

LOG_CHANNEL=stderr
LOG_LEVEL=error

# Database Configuration (MySQL, PostgreSQL, or SQLite)
# If using PostgreSQL: set DB_CONNECTION=pgsql and DB_PORT=5432
# If using MySQL: set DB_CONNECTION=mysql and DB_PORT=3306
# If using SQLite: set DB_CONNECTION=sqlite and DB_DATABASE=/var/www/html/storage/app/database.sqlite
DB_CONNECTION=mysql
DB_HOST=your-db-host.render.com
DB_PORT=3306
DB_DATABASE=novasyn_db
DB_USERNAME=novasyn_user
DB_PASSWORD=your_secure_db_password

# Session & Cache (File is simple and does not require Redis or Database tables)
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Storage Disk (Make sure to mount a Render Disk at /var/www/html/storage to persist images)
FILESYSTEM_DISK=public

# Startup Behavior
# Set RUN_MIGRATIONS=true to run migrations on deploy
RUN_MIGRATIONS=true
# Set RUN_SEEDER=true to seed default data on deploy (optional)
RUN_SEEDER=true
# Set FRESH_DATABASE=true ONLY if you want to wipe and rebuild the database (WARNING: clears all data)
FRESH_DATABASE=false
